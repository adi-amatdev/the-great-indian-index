{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bharat-indexes",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-09-01",
	// nodejs_compat is required by the OpenNext Next.js adapter.
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// D1 database for paper-trading state (users, sessions, positions, trades).
	// Bound as `DB` — the app reads it via getCloudflareContext().env.DB.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bharat-indexes-db",
			"database_id": "2770e460-17ca-42d6-8261-471173b108a0",
			"migrations_dir": "migrations"
		}
	]
}
