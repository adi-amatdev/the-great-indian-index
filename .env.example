# Neon Postgres connection string.
# Get it from your Neon project → Connect → pooled connection string.
# Example: postgres://user:pass@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# Comma-separated addresses allowed into /admin.
ADMIN_EMAILS=admin@example.com
# Comma-separated NSE holiday dates in YYYY-MM-DD format.
MARKET_HOLIDAYS=2026-10-02,2026-10-20
# Same holiday list exposed to the client status badge.
NEXT_PUBLIC_MARKET_HOLIDAYS=2026-10-02,2026-10-20
