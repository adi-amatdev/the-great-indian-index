// Prisma schema for Bharat Indexes. Backed by PostgreSQL on Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt    @id @default(autoincrement())
  username  String    @unique
  email     String?   @unique
  passHash  String
  cash      Float
  createdAt BigInt
  bio       String?
  about     String?
  links     Json?
  sessions  Session[]
  positions Position[]
  trades    Trade[]
  customIndexes CustomIndex[]
  collaboratesOn CustomIndexCollaborator[]
  sentInvites CustomIndexInvite[] @relation("InviteSender")
  receivedInvites CustomIndexInvite[] @relation("InviteRecipient")

  @@map("users")
}

model Session {
  token     String @id
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    BigInt
  createdAt BigInt

  @@map("sessions")
  @@index([userId])
}

model Position {
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    BigInt
  slug      String
  weighting String
  units     Float  @default(0)
  cost      Float  @default(0)

  @@id([userId, slug, weighting])
  @@map("positions")
}

model Trade {
  id        BigInt @id @default(autoincrement())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    BigInt
  slug      String
  weighting String
  side      String
  units     Float
  price     Float
  amount    Float
  ts        BigInt

  @@map("trades")
  @@index([userId, ts(sort: Desc)])
}

model CustomIndex {
  id          BigInt @id @default(autoincrement())
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      BigInt
  slug        String @unique
  name        String
  tagline     String
  description String
  sources     Json?
  createdAt   BigInt
  updatedAt   BigInt
  constituents CustomIndexConstituent[]
  collaborators CustomIndexCollaborator[]
  invites CustomIndexInvite[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("custom_indexes")
}

model CustomIndexConstituent {
  id           BigInt @id @default(autoincrement())
  customIndex  CustomIndex @relation(fields: [customIndexId], references: [id], onDelete: Cascade)
  customIndexId BigInt
  symbol       String
  name         String
  weight       Float

  @@unique([customIndexId, symbol])
  @@map("custom_index_constituents")
}

// Membership of a custom index beyond its creator. Creator is always the
// CustomIndex.userId (an implicit owner); invited users land here and get full
// edit access, so every "co-owner" can CRUD the basket and run analysis on it.
model CustomIndexCollaborator {
  customIndex   CustomIndex @relation(fields: [customIndexId], references: [id], onDelete: Cascade)
  customIndexId BigInt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        BigInt
  role          String      @default("editor") // owner | editor
  addedBy       BigInt
  createdAt     BigInt

  @@id([customIndexId, userId])
  @@index([userId])
  @@map("custom_index_collaborators")
}

model CustomIndexInvite {
  id            BigInt @id @default(autoincrement())
  customIndex   CustomIndex @relation(fields: [customIndexId], references: [id], onDelete: Cascade)
  customIndexId BigInt
  inviter       User @relation("InviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId     BigInt
  recipient     User @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId   BigInt
  status        String @default("pending") // pending | accepted | declined
  createdAt     BigInt
  respondedAt  BigInt?

  @@index([recipientId, status, createdAt(sort: Desc)])
  @@index([customIndexId, status])
  @@map("custom_index_invites")
}

// Frequency-aware cache of computed index series. Storing the fully computed
// IndexData here means popular comparisons (high hitCount) skip the ~30 Yahoo
// chart fetches per request and are served straight from Postgres, refreshed in
// the background before they go stale.
model IndexCache {
  key         String  @id // `slug:range:weighting` (built-ins) or `custom:<sig>:range:weighting`
  slug        String
  range       String
  weighting   String
  data        Json
  hitCount    Int     @default(0)
  requestedAt BigInt // unix ms of last request
  updatedAt   BigInt // unix ms of last refresh
  createdAt   BigInt // unix ms of first request

  @@index([hitCount, updatedAt])
  @@map("index_cache")
}
